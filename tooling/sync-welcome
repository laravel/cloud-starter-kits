#!/usr/bin/env python3
"""
Renders tooling/welcome/welcome.html into every kit's welcome screen.

The source is written with Tailwind classes. Kits with a Tailwind build
(Next.js, Nuxt, Astro, Rails) get the markup inside their own layout. Kits
without a frontend build on Cloud (Django, FastAPI, Go, Express) get a full
HTML page that loads Tailwind's browser build from a CDN. Each kit's framework
name and a template expression for its running version are filled in. Edit the
source, never the generated files, then run this script.

Pass --check to fail instead of writing when a kit is out of date.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "tooling" / "welcome" / "welcome.html"
TAILWIND_CDN = "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"
NOTICE = "Laravel Cloud welcome screen. Replace it with the app's own home page."

KITS = {
    "astro": {
        "format": "tailwind-astro",
        "target": "src/pages/index.astro",
        "framework": "Astro",
        "version": "{version}",
        "runtime": " · Node.js {process.versions.node}",
    },
    "django": {
        "format": "document",
        "target": "pages/templates/pages/home.html",
        "framework": "Django",
        "version": "{{ version }}",
        "runtime": " · Python {{ python_version }}",
    },
    "express": {
        "format": "document",
        "target": "src/welcome.html",
        "framework": "Express",
        "version": "{{version}}",
        "runtime": " · Node.js {{node_version}}",
    },
    "fastapi": {
        "format": "document",
        "target": "app/welcome.html",
        "framework": "FastAPI",
        "version": "{{version}}",
        "runtime": " · Python {{python_version}}",
    },
    "go": {
        "format": "document",
        "target": "welcome.html",
        "framework": "Go",
        "version": "{{.Version}}",
    },
    "nextjs": {
        "format": "tailwind-next",
        "target": "app/page.tsx",
        "framework": "Next.js",
        "version": "{version}",
        "runtime": " · Node.js {process.versions.node}",
    },
    "nuxt": {
        "format": "tailwind-vue",
        "target": "app/pages/index.vue",
        "framework": "Nuxt",
        "version": "{{ version }}",
        "runtime": " · Node.js {{ nodeVersion }}",
    },
    "rails": {
        "format": "tailwind-erb",
        "target": "app/views/pages/home.html.erb",
        "framework": "Rails",
        "version": "<%= Rails.version %>",
        "runtime": " · Ruby <%= RUBY_VERSION %>",
    },
}

JSX_ATTRIBUTES = {
    "class=": "className=",
    "fill-rule=": "fillRule=",
    "clip-rule=": "clipRule=",
    "stroke-linecap=": "strokeLinecap=",
}


def fill(text: str, kit: dict) -> str:
    return (
        text.replace("__FRAMEWORK__", kit["framework"])
        .replace("__VERSION__", kit["version"])
        .replace("__RUNTIME__", kit.get("runtime", ""))
    )


def indent(text: str, spaces: int) -> str:
    return "\n".join((" " * spaces + line) if line else line for line in text.splitlines())


def markup_of(source: str) -> str:
    """The source without its leading comment."""
    return re.sub(r"<!--.*?-->\n", "", source, count=1, flags=re.S).rstrip("\n")


def jsx(markup: str) -> str:
    for html, react in JSX_ATTRIBUTES.items():
        markup = markup.replace(html, react)
    return markup


def render(kit: dict, source: str) -> dict[str, str]:
    markup = fill(markup_of(source), kit)
    title = f"{kit['framework']} on Laravel Cloud"

    if kit["format"] == "document":
        return {
            kit["target"]: (
                "<!doctype html>\n"
                f"<!-- {NOTICE} -->\n"
                '<html lang="en">\n'
                "    <head>\n"
                '        <meta charset="utf-8" />\n'
                '        <meta name="viewport" content="width=device-width, initial-scale=1" />\n'
                f"        <title>{title}</title>\n"
                '        <link rel="preconnect" href="https://fonts.bunny.net" />\n'
                '        <link href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600" rel="stylesheet" />\n'
                f'        <script src="{TAILWIND_CDN}"></script>\n'
                "    </head>\n"
                "    <body>\n"
                f"{indent(markup, 8)}\n"
                "    </body>\n"
                "</html>\n"
            )
        }

    if kit["format"] == "tailwind-astro":
        return {
            kit["target"]: (
                "---\n"
                f"// {NOTICE}\n"
                "import Layout from '../layouts/Layout.astro';\n\n"
                "const version = Astro.generator.replace(/^Astro v/, '');\n"
                "---\n\n"
                f'<Layout title="{title}">\n'
                f"{indent(markup, 4)}\n"
                "</Layout>\n"
            )
        }

    if kit["format"] == "tailwind-vue":
        return {
            kit["target"]: (
                f"<!-- {NOTICE} -->\n"
                '<script setup lang="ts">\n'
                "const version = useNuxtApp().versions.nuxt;\n"
                "const nodeVersion = useState('node-version', () => process.versions.node);\n\n"
                "useHead({\n"
                f"    title: '{title}',\n"
                "    link: [\n"
                "        { rel: 'preconnect', href: 'https://fonts.bunny.net' },\n"
                "        { rel: 'stylesheet', href: 'https://fonts.bunny.net/css?family=instrument-sans:400,500,600' },\n"
                "    ],\n"
                "});\n"
                "</script>\n\n"
                "<template>\n"
                f"{indent(markup, 4)}\n"
                "</template>\n"
            )
        }

    if kit["format"] == "tailwind-next":
        return {
            kit["target"]: (
                f"// {NOTICE}\n"
                "import type { Metadata } from 'next';\n"
                "import next from 'next/package.json';\n\n"
                "export const metadata: Metadata = {\n"
                f"    title: '{title}',\n"
                "};\n\n"
                "export default function Home() {\n"
                "    const { version } = next;\n\n"
                "    return (\n"
                f"{indent(jsx(markup), 8)}\n"
                "    );\n"
                "}\n"
            )
        }

    if kit["format"] == "tailwind-erb":
        return {
            kit["target"]: (
                f"<%# {NOTICE} %>\n"
                f'<% content_for :title, "{title}" %>\n'
                "<% content_for :head do %>\n"
                '  <link rel="preconnect" href="https://fonts.bunny.net">\n'
                '  <link href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600" rel="stylesheet">\n'
                "<% end %>\n\n"
                f"{markup}\n"
            )
        }

    raise ValueError(f"Unknown format: {kit['format']}")


def main() -> int:
    check = "--check" in sys.argv[1:]
    source = SOURCE.read_text()
    stale = False

    for name, kit in KITS.items():
        for relative, content in render(kit, source).items():
            path = ROOT / name / relative
            if path.exists() and path.read_text() == content:
                continue
            if check:
                print(f"Out of date: {name}/{relative}")
                stale = True
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(content)
                print(f"Updated: {name}/{relative}")

    return 1 if stale else 0


if __name__ == "__main__":
    sys.exit(main())
