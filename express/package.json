{
    "name": "express-starter-kit",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/server.ts",
        "start": "node src/server.ts",
        "test": "node --test",
        "lint": "tsc --noEmit && eslint . && prettier --check .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    }
}
